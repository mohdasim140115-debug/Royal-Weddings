# ─────────────────────────────────────────────────────────────
# Royal Wedding — environment variables
# Copy to .env (or .env.local) and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Database: PostgreSQL on Neon (Vercel → Storage → Neon, prefix "DATABASE").
# Copy both lines from the database's ".env.local" tab.
DATABASE_URL=""            # pooled connection (used by the app)
DATABASE_URL_UNPOOLED=""   # direct connection (used by prisma migrate)

# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session signing secret (min. 32 random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# First admin account, created by `npm run db:seed` or `npm run admin:create`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Google Maps Routes API (server-side only). Restrict this key to the
# "Routes API" and to your server's IPs. Leave empty to run in manual-distance mode.
GOOGLE_MAPS_API_KEY=""

# Razorpay (server-side). Leave empty to disable online payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email via Resend (https://resend.com). Leave empty to log-and-skip.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""            # e.g. "Royal Wedding <bookings@yourdomain.com>"
EMAIL_ADMIN_TO=""        # where new-booking alerts go

# WhatsApp Business Cloud API (optional server-side messages).
WHATSAPP_PROVIDER_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Vercel Blob (Vercel → Storage → Blob). Set automatically when the store is
# connected to the project. Without it, admin uploads go to UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""

# Protects the reminder cron endpoint (GET /api/cron/reminders).
CRON_SECRET=""
